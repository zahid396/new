# Use the official FrankenPHP production image with PHP 8.5
FROM dunglas/frankenphp:1-php8.5

# Install the required production PHP extensions (including MySQL)
RUN install-php-extensions \
    pcntl \
    pdo_mysql \
    opcache \
    intl \
    zip

# Set working directory inside the container
WORKDIR /app

# Copy the Laravel application files
COPY . /app

# Install production dependencies via Composer
RUN composer install --no-dev --optimize-autoloader

# Optimizing Laravel configuration loading for production
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# Expose port 80 (Render forwards web traffic here)
EXPOSE 80

# Run FrankenPHP via Laravel Octane in Worker Mode
ENTRYPOINT ["php", "artisan", "octane:frankenphp", "--host=0.0.0.0", "--port=80"]